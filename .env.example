# Copy to .env (never committed) and fill in. Generate passwords with: openssl rand -hex 24
POSTGRES_PASSWORD=
# login of the control app: name:password (several separated by commas)
MLOPS_AUTH=admin:
# key of the pseudonymous group hashes (keep it: changing it changes the split of new pages)
MLOPS_SECRET=
# https://wandb.ai/authorize
WANDB_API_KEY=
# GitHub fine-grained token, repository NiemaAM/MaDoc only: Contents read/write, Pull requests read/write
GH_TOKEN=
