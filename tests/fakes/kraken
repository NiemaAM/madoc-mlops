#!/usr/bin/env python3
"""A stand-in for kraken in the tests: "reads" a page by copying its transcription (in kraken's visual order).
A model of the runs folder (a candidate) reads every line; a production model loses the last line and the
last word of every line. With -x it writes a PageXML (the true one, its texts replaced, the same line ids), as
kraken does; without, one text line per line."""
import pathlib, re, sys
from bidi.algorithm import get_display
a = sys.argv[1:]
pairs, models, xml_out = [], [], False
i = 0
while i < len(a):
    if a[i] in ("-d", "-f"):
        i += 2; continue
    if a[i] == "-x":
        xml_out = True; i += 1; continue
    if a[i] == "-i" and i + 2 < len(a) and not a[i + 1].endswith(".mlmodel"):
        pairs.append((pathlib.Path(a[i + 1]), pathlib.Path(a[i + 2]))); i += 3; continue
    if a[i] in ("-m", "-i") and i + 1 < len(a) and a[i + 1].endswith(".mlmodel"):
        models.append(a[i + 1])
    i += 1
good = "/runs/" in models[0]   # the model being evaluated: segmentation first, else recognition
for source, out in pairs:
    xml = source if source.suffix == ".xml" else source.with_suffix(".xml")
    text = xml.read_text(encoding="utf-8")
    lines = re.findall(r"<Unicode>(.*?)</Unicode>", text)
    if not good:
        lines = [" ".join(l.split()[:-1]) for l in lines[:-1]]
    if not xml_out:
        out.write_text("\n".join(get_display(l) for l in lines), encoding="utf-8")
        continue
    blocks = re.findall(r"<TextLine\b.*?</TextLine>", text, re.S)
    kept = []
    for block, line in zip(blocks, lines):
        kept.append(re.sub(r"<Unicode>.*?</Unicode>", "<Unicode>" + get_display(line) + "</Unicode>", block, count=1))
    body = text[:text.index(blocks[0])] + "".join(kept) + text[text.index(blocks[-1]) + len(blocks[-1]):] if blocks else text
    out.write_text(body, encoding="utf-8")
