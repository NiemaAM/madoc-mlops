# The other recognizers (mlops/baselines): the platform's image plus the Hugging Face libraries.
# The code is copied again here: the base image may be older than the code (build mlops-worker first anyway:
#   docker compose build mlops-worker && docker compose build mlops-baselines).
FROM madoc-mlops:latest

USER root
RUN pip install transformers==4.57.1 peft==0.17.1 accelerate==1.10.1 \
 && mkdir -p /hf-cache && chown mlops /hf-cache
WORKDIR /app
COPY . .
USER mlops

CMD ["python", "-m", "mlops.worker"]